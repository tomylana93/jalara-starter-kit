{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "audit:check": "pnpm audit --registry=https://registry.npmjs.org --audit-level=high",
        "format": "prettier --write resources/ vite/",
        "format:check": "prettier --check resources/ vite/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "e2e/run-tests.sh",
        "types:check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/echo-vue": "^2.4.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.62.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^26.1.2",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^10.0.4",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^10.10.0",
        "jsdom": "^30.0.1",
        "laravel-echo": "^2.4.0",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "pusher-js": "^8.6.0",
        "shadcn-vue": "^2.8.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.9"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@lucide/vue": "^1.29.0",
        "@tanstack/vue-table": "^9.1.2",
        "@tiptap/core": "^3.29.2",
        "@tiptap/extension-link": "^3.29.2",
        "@tiptap/extension-placeholder": "^3.29.2",
        "@tiptap/extension-table": "^3.29.2",
        "@tiptap/starter-kit": "^3.29.2",
        "@tiptap/vue-3": "^3.29.2",
        "@vueuse/core": "^14.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-vite-plugin": "^3.0.0",
        "puppeteer": "^25.5.0",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.41",
        "vue-sonner": "^2.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.62.4",
        "@rollup/rollup-win32-x64-msvc": "4.62.4",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
