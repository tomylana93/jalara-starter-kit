{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jalara/starter-kit",
    "type": "project",
    "description": "Jalara Starter Kit: an Inertia Vue application starter with settings, branding, and authorization built in.",
    "keywords": [
        "jalara",
        "starter-kit"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.3.1",
        "intervention/image": "^4.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/reverb": "^1.11",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.21",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-settings": "^3.9",
        "spatie/simple-excel": "^3.10"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.24",
        "fruitcake/laravel-debugbar": "^4.4",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.5",
        "laravel/doctor": "^0.1",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.1.3",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force",
            "@php artisan storage:link --force --no-interaction",
            "pnpm install",
            "pnpm run build"
        ],
        "ci:setup": [
            "composer install --no-interaction --prefer-dist",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --no-interaction",
            "pnpm install --frozen-lockfile"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "doctor:check": [
            "@php artisan doctor --no-interaction --format=agent"
        ],
        "doctor:fix": [
            "@php artisan doctor --fix"
        ],
        "lint": [
            "pint --parallel"
        ],
        "format:agent": [
            "pint --dirty --format agent"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "rector": [
            "rector process --no-progress-bar --output-format=json"
        ],
        "rector:check": [
            "rector process --dry-run --no-progress-bar --output-format=json"
        ],
        "audit:check": [
            "composer audit --locked --no-interaction",
            "pnpm run audit:check"
        ],
        "coverage:check": [
            "pest --coverage --min=80 --only-summary-for-coverage-text"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm run lint:check",
            "pnpm run format:check",
            "pnpm run types:check",
            "pnpm run test:unit",
            "@test"
        ],
        "ci:full": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm run lint:check",
            "pnpm run format:check",
            "pnpm run types:check",
            "pnpm run test:unit",
            "@static:check",
            "@coverage:check",
            "pnpm run test:e2e"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G --no-progress --error-format=json"
        ],
        "static:check": [
            "@php artisan config:clear --ansi",
            "@rector:check",
            "@lint:check",
            "@types:check"
        ],
        "test": [
            "@static:check",
            "pest"
        ],
        "agents:update": [
            "@php artisan boost:update --no-interaction"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": [
                    "@php artisan storage:link --force --no-interaction"
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
