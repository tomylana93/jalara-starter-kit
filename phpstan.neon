includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    # The default result cache lives in the system temporary directory, which is
    # empty on every CI runner. A project directory lets CI restore it.
    tmpDir: .cache/phpstan

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: 7

    stubFiles:
        - tests/PHPStan/Settings.stub
