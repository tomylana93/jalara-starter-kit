{
    "mcpServers": {
        "serena": {
            "type": "http",
            "url": "http://localhost:9121/mcp"
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
            }
        },
        "shadcn": {
            "command": "pnpm",
            "args": [
                "dlx",
                "shadcn-vue@latest",
                "mcp"
            ]
        },
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        }
    }
}