{
    "//": "Shared by resources/js/lib/dateTime.test.ts and tests/Unit/InstantFormatterTest.php. A PDF renders in server-side Chromium, so the browser cannot format its timestamps and PHP has to reproduce formatBrowserDateTime exactly. Two implementations of one rule only stay equal if one expectation feeds both: editing a case here changes both suites at once, and changing either formatter alone turns one of them red.",
    "cases": [
        {
            "name": "crosses into the next day in the viewer zone",
            "instant": "2026-07-30T22:30:00.000000Z",
            "dateFormat": "d/m/Y",
            "timeZone": "Asia/Jakarta",
            "locale": "en",
            "expected": "31/07/2026 05:30"
        },
        {
            "name": "crosses back into the previous day west of UTC",
            "instant": "2026-07-31T02:15:00.000000Z",
            "dateFormat": "d/m/Y",
            "timeZone": "America/New_York",
            "locale": "en",
            "expected": "30/07/2026 22:15"
        },
        {
            "name": "orders the iso preset year first",
            "instant": "2026-07-30T22:30:00.000000Z",
            "dateFormat": "Y-m-d",
            "timeZone": "Asia/Jakarta",
            "locale": "en",
            "expected": "2026-07-31 05:30"
        },
        {
            "name": "orders the month first for the american preset",
            "instant": "2026-07-30T22:30:00.000000Z",
            "dateFormat": "m/d/Y",
            "timeZone": "Asia/Jakarta",
            "locale": "en",
            "expected": "07/31/2026 05:30"
        },
        {
            "name": "names the month in english",
            "instant": "2026-08-06T01:05:00.000000Z",
            "dateFormat": "d M Y",
            "timeZone": "Asia/Jakarta",
            "locale": "en",
            "expected": "06 Aug 2026 08:05"
        },
        {
            "name": "names the month in indonesian",
            "instant": "2026-08-06T01:05:00.000000Z",
            "dateFormat": "d M Y",
            "timeZone": "Asia/Jakarta",
            "locale": "id",
            "expected": "06 Agu 2026 08:05"
        },
        {
            "name": "keeps a 24 hour clock past noon",
            "instant": "2026-08-06T10:45:00.000000Z",
            "dateFormat": "d/m/Y",
            "timeZone": "Asia/Jakarta",
            "locale": "en",
            "expected": "06/08/2026 17:45"
        },
        {
            "name": "pads a single digit day and month",
            "instant": "2026-01-02T03:04:00.000000Z",
            "dateFormat": "d/m/Y",
            "timeZone": "UTC",
            "locale": "en",
            "expected": "02/01/2026 03:04"
        },
        {
            "name": "falls back to the iso ordering for an unknown preset",
            "instant": "2026-07-30T22:30:00.000000Z",
            "dateFormat": "not-a-preset",
            "timeZone": "Asia/Jakarta",
            "locale": "en",
            "expected": "2026-07-31 05:30"
        },
        {
            "name": "renders a dash when there is no instant",
            "instant": null,
            "dateFormat": "d/m/Y",
            "timeZone": "Asia/Jakarta",
            "locale": "en",
            "expected": "—"
        }
    ]
}
