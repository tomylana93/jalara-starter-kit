{
  "mcpServers": {
    "serena": {
      "serverUrl": "http://localhost:9121/mcp"
    },
    "shadcn": {
      "command": "pnpm",
      "args": [
        "dlx",
        "shadcn-vue@latest",
        "mcp"
      ]
    },
    "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        }
  }
}
